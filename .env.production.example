# Core-only by default. Add wechat and/or trendradar to start local collectors.
# Use COMPOSE_PROFILES (also passed to initialization), e.g. wechat,trendradar.
COMPOSE_PROFILES=
# 配合 docker-compose.images.yml 和 --no-build 使用已发布镜像。
JIANWEI_IMAGE_TAG=
DATABASE_POOL_MAX=4
WORKER_CONCURRENCY=2
# 仅清理已结束的采集/请求运行历史；0 关闭清理。原文、事件证据和回执保留。
OPERATIONAL_HISTORY_DAYS=30
FAILED_HISTORY_DAYS=90

# Copy to `.env.production` on the server and replace every `change-me-*`.
# Start production with:
#   docker compose --env-file .env.production -p jianwei -f docker-compose.prod.yml up -d --build

# --- Public domain / HTTPS ---------------------------------------------
# Point this domain's A/AAAA record to the server first. Caddy will request
# Let's Encrypt certificates automatically.
JIANWEI_DOMAIN=jianwei.example.com
ACME_EMAIL=admin@example.com

# --- Required secrets ---------------------------------------------------
# Generate examples:
#   openssl rand -base64 32   # APP_ENCRYPTION_KEY
#   openssl rand -hex 32      # ADMIN_API_TOKEN / session secret / refresh token
POSTGRES_PASSWORD=change-me-postgres-password
APP_ENCRYPTION_KEY=change-me-32-byte-base64-key
ADMIN_USERNAME=admin
# 固定首次登录密码，降低安装门槛；登录后请在后台立即修改。
ADMIN_PASSWORD=admin@123
ADMIN_API_TOKEN=change-me-admin-token
ADMIN_SESSION_SECRET=change-me-admin-session-secret
TRENDRADAR_REFRESH_TOKEN=change-me-trendradar-refresh-token

# --- X / Twitter --------------------------------------------------------
X_BEARER_TOKEN=
X_API_MAX_PAGES=20

# --- Web search providers ----------------------------------------------
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
X_BRAVE_MONTHLY_BUDGET_USD=35
BUDGET_RESERVATION_TTL_MINUTES=60

# --- WeRSS --------------------------------------------------------------
WERSS_IMAGE=jianwei-werss:local
WERSS_UPSTREAM_IMAGE=ghcr.io/rachelos/we-mp-rss@sha256:af771f21b3f7958a5dea16911fba050a6d7b92eac2fb2499c467c1b11f07ef34
# In production, keep WeRSS private. Use SSH tunnel for the authorization UI:
#   ssh -L 8001:127.0.0.1:8001 <user>@<server>
WERSS_DOCKER_BASE_URL=
TRENDRADAR_DOCKER_MCP_URL=
WERSS_ACCESS_KEY=
WERSS_MEM_LIMIT=2g
WERSS_CPUS=1.5
WERSS_PIDS_LIMIT=200
WERSS_MAX_PAGES=20

# --- ZLZChat (optional, separately deployed) ----------------------------
# Use a private/internal URL. Do not point production credentials at a public demo.
ZLZCHAT_BASE_URL=
ZLZCHAT_API_KEY=
ZLZCHAT_TIMEOUT_SECONDS=15
ZLZCHAT_PAGE_SIZE=30
ZLZCHAT_MAX_PAGES=20
# 私网 ZLZChat 必须填写精确 origin（协议 + 主机 + 端口），多个值用逗号分隔。
ZLZCHAT_ALLOWED_ORIGINS=

# --- TrendRadar ---------------------------------------------------------
TRENDRADAR_CRON_SCHEDULE=*/30 * * * *
TRENDRADAR_MCP_TIMEOUT_SECONDS=12
TRENDRADAR_PUBLIC_CACHE_SECONDS=20
TRENDRADAR_PUBLIC_REQUESTS_PER_MINUTE=120

# --- Worker -------------------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=60
# Leave empty for one worker. In a multi-worker deployment set a unique value
# per replica so leases and health records remain instance-specific.
WORKER_ID=
WORKER_MONITOR_LEASE_SECONDS=1800
DOCUMENT_ANALYSIS_CLAIM_LEASE_MINUTES=30

# --- Model API defaults (optional; can also be configured in admin UI) ---
SUMMARY_PROVIDER=
SUMMARY_BASE_URL=
SUMMARY_API_KEY=
# 所有模型入口共享每日请求上限（北京时间），0 停用新请求；缓存仍可复用。
MODEL_DAILY_REQUEST_LIMIT=1000
SUMMARY_SKIP_PLATFORMS=wechat
SUMMARY_MODEL=
SUMMARY_TIMEOUT_SECONDS=20
SUMMARY_MAX_CONCURRENCY=2
SUMMARY_REQUESTS_PER_MINUTE=
SUMMARY_RATE_LIMIT_KEY=

# --- TrendRadar AI report sidecar compatibility (optional) --------------
AI_ANALYSIS_ENABLED=false
AI_API_KEY=
AI_MODEL=
AI_API_BASE=
